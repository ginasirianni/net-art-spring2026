margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  height: 100vh;
}

.grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  width: 100vw;
  height: 100vh;
}

/* base square */
.square {
  width: 100%;
  height: 100%;
}

/* colors */
.pink {
  background: #ff7eb9;
}

.purple {
  background: #a06cd5;
}

.brown {
  background: #c98b47;
}

/* cheetah style square */
.cheetah {
  background: #c98b47;
  position: relative;
}

.cheetah::before,
.cheetah::after {
  content: "";
  position: absolute;
  background: #111;
  border-radius: 50%;
}

.cheetah::before {
  width: 20px;
  height: 15px;
  top: 20%;
  left: 30%;
}

.cheetah::after {
  width: 25px;
  height: 18px;
  bottom: 25%;
  right: 20%;
}

/* extra shapes for variation */
.square:nth-child(3n) {
  border-radius: 50%;
}

.square:nth-child(4n) {
  opacity: 0.8;
}

.square:nth-child(5n) {
  transform: rotate(5deg);
}
